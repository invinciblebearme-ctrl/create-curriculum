# Cloudflare Pages / Local Environment Configuration

# Production / Cloudflare Access
CF_ACCESS_AUD=your-cloudflare-access-aud-value
CF_ACCESS_TEAM_DOMAIN=your-team-name.cloudflareaccess.com
ADMIN_EMAIL=admin@example.com

# Local Development Flag
# Set to true to enable local Mock database/storage mode without Cloudflare bindings
VITE_ENABLE_MOCK_FALLBACK=true
