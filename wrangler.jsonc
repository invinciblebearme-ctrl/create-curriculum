{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "future-curriculum",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2024-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // Cloudflare D1 & R2 Storage Binding
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "create-curriculum-db",
      "database_id": "bb77e0b3-a6ee-4492-ae35-820902ba9368"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "create-curriculum-storage"
    }
  ],

  // Environment variables
  "vars": {
    "ADMIN_EMAIL": "admin@school.ed.kr",
    "ADMIN_PASSWORD": "7703"
  }
}
